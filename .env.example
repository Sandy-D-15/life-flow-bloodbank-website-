# LifeFlow Blood Bank - Environment Configuration Template
# Copy this file to .env and replace placeholder values with your real configuration.

# Server Configuration
PORT=5000
NODE_ENV=development
APP_URL=http://localhost:5000
CLIENT_ORIGIN=http://localhost:5173

# Database & Storage
# Set USE_JSON_FALLBACK=true to use local JSON file storage (server/data/lifeflow_db.json)
USE_JSON_FALLBACK=true
MONGO_URI=mongodb+srv://<username>:<password>@<cluster>.mongodb.net/lifeflow_blood_bank?retryWrites=true&w=majority

# Authentication & Sessions
JWT_SECRET=replace_with_a_secure_random_32_byte_hex_string
ADMIN_USERNAME=admin
ADMIN_PASSWORD=replace_with_secure_admin_password
STAFF_USERNAME=staff
STAFF_PASSWORD=replace_with_secure_staff_password

# Email Notifications (SMTP)
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_USER=user@example.com
SMTP_PASS=replace_with_smtp_password
SMTP_FROM=no-reply@lifeflow.org
