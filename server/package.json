{
  "name": "lifeflow-backend",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx server.ts",
    "build": "esbuild server.ts --bundle --platform=node --format=esm --packages=external --outfile=dist/server.js",
    "prestart": "npm run build",
    "start": "node dist/server.js",
    "test": "tsx ../tests/api.test.ts"
  },
  "dependencies": {
    "dotenv": "^17.2.3",
    "esbuild": "^0.27.0",
    "express": "^4.21.2",
    "jsonwebtoken": "^9.0.3",
    "mongodb": "^7.7.0",
    "nodemailer": "^10.1.7"
  },
  "devDependencies": {
    "@types/express": "^4.17.21",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/node": "^22.14.0",
    "@types/nodemailer": "^8.0.2",
    "tsx": "^4.21.0",
    "typescript": "^5.0.0"
  }
}
